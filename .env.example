# Claude AI
CLAUDE_API_KEY=your_anthropic_api_key_here

# MetaTrader 5
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe  # Windows
# MT5_PATH=/Applications/MetaTrader\ 5.app/Contents/MacOS/MetaTrader\ 5  # Mac

# Trading Settings
SYMBOL=EURUSD
TIMEFRAME=5  # 1, 5, 15, 30, 60, 240, 1440 (minutes)
LOT_SIZE=0.1
RISK_PERCENT=2.0
MAX_POSITIONS=3

# Logging
LOG_LEVEL=INFO
DEBUG=False
